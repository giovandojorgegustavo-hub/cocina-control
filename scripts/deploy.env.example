# scripts/deploy.env — configuracion de scripts/deploy.sh para este repo.
#
# COPIAR A scripts/deploy.env EN EL SERVER. Nunca se versiona: apunta a una
# maquina concreta, y deploy.sh RECHAZA el archivo si es de otro dueno o si
# tiene permiso de escritura para grupo u otros (contrato de fabrica, issue
# fabrica#22). Dejarlo en git haria imposible cumplir ese contrato.
#
#   cp scripts/deploy.env.example scripts/deploy.env
#   chmod 600 scripts/deploy.env

# Unidad de systemd que se reinicia tras desplegar.
SERVICE_NAME=cocina-control.service

# URL del smoke test. Tiene que devolver {"status":"ok","commit":"<40 hex>"}
# (ver docs/salud-endpoint.md e issue #150).
#
# OJO con el path: el contrato de fabrica usa /salud por defecto, pero este
# repo expone /health desde antes de darse de alta. Por eso se declara aca —
# el contrato lo permite explicitamente. No renombrar el endpoint sin migrar
# tambien el paso "Verify /health responds" de .github/workflows/release.yml.
#
# El puerto es el del backend detras de Caddy, no el 443 publico: el smoke
# test corre EN el server y prueba el proceso, no el proxy.
HEALTH_URL=http://127.0.0.1:8001/health

# Migraciones. Vacio = no correr ninguna.
MIGRATIONS_CMD=uv run alembic upgrade head

# Rama desde la que se despliega. Por defecto main.
BRANCH=main

# Segundos que espera el smoke test antes de dar el deploy por fallido.
# El arranque de uvicorn + la conexion a Postgres entran comodos en 60.
HEALTH_DEADLINE=60
